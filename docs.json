{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "ModelRunner Docs",
  "colors": {
    "primary": "#0f172a",
    "light": "#569dff",
    "dark": "#0f172a"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book",
        "description": "Set up your documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "api-keys",
              "guides/request-lifecycle",
              "faq"
            ]
          },
          {
            "group": "Wrappers",
            "pages": [
              "guides/wrappers/overview",
              "guides/wrappers/authoring",
              "guides/wrappers/prompt-templates",
              "guides/wrappers/switching-base-models"
            ]
          },
          {
            "group": "Platform features",
            "pages": [
              "guides/language-models",
              "guides/file-uploads",
              "guides/webhooks",
              "guides/data-retention",
              "guides/mcp-server"
            ]
          },
          {
            "group": "SDKs & recipes",
            "pages": [
              "clients/js-client",
              "clients/python-client",
              "recipes-nextjs-app"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "description": "Reference for the API",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/request-semantics",
              "api-reference/errors"
            ]
          },
          {
            "group": "Queue API",
            "openapi": "openapi.json",
            "pages": [
              "POST /{ownerName}/{modelName}",
              "GET /{ownerName}/{modelName}/requests/{requestId}/status",
              "GET /{ownerName}/{modelName}/requests/{requestId}",
              "GET /requests",
              "GET /requests/{requestId}",
              "GET /requests/stream",
              "PATCH /requests/{requestId}/visibility",
              "DELETE /requests/{requestId}/payloads"
            ]
          },
          {
            "group": "Platform APIs",
            "pages": [
              {
                "group": "Model catalog",
                "openapi": "platform-openapi.json",
                "pages": [
                  "GET /models",
                  "GET /models/facets",
                  "GET /models/featured",
                  "GET /models/pricing",
                  "GET /models/{ownerName}/{alias}/openapi.json",
                  "GET /search",
                  "GET /collections",
                  "GET /collections/{slug}"
                ]
              },
              {
                "group": "Uploads",
                "openapi": "platform-openapi.json",
                "pages": [
                  "POST /storage/upload/initiate",
                  "POST /storage/upload/initiate-multipart",
                  "GET /storage/upload/multipart-url",
                  "POST /storage/upload/complete",
                  "POST /storage/upload/chunk",
                  "PUT /storage/upload/relay"
                ]
              },
              {
                "group": "Assets",
                "openapi": "platform-openapi.json",
                "pages": [
                  "GET /files",
                  "GET /files/facets",
                  "GET /files/by-url",
                  "GET /files/{fileId}",
                  "DELETE /files/{fileId}",
                  "POST /files/{fileId}/favorite",
                  "DELETE /files/{fileId}/favorite",
                  "POST /files/{fileId}/tags",
                  "DELETE /files/{fileId}/tags/{tagId}",
                  "GET /tags",
                  "POST /tags",
                  "DELETE /tags/{tagId}"
                ]
              },
              {
                "group": "Account",
                "openapi": "platform-openapi.json",
                "pages": [
                  "GET /billing/balance",
                  "GET /billing/usage-summary"
                ]
              },
              {
                "group": "Webhooks",
                "openapi": "platform-openapi.json",
                "pages": [
                  "GET /webhooks/default/secret",
                  "POST /webhooks/default/secret/rotate",
                  "GET /webhooks/deliveries",
                  "POST /webhooks/deliveries/{deliveryId}/replay"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@modelrunner.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "ModelRunner",
      "href": "https://modelrunner.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/modelrunnerai",
      "github": "https://github.com/modelrunner"
    }
  },
  "playground": {
    "display": "interactive",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "all"
    }
  },
  "integrations": {
    "posthog": {
      "apiKey": "phc_xdh7FwyduKSaB5wLndEYCqdGB7uVqtvJvVmuVbSZPuqp",
      "apiHost": "https://us.i.posthog.com"
    }
  },
  "redirects": [
