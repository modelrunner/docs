      "destination": "/api-reference/get-model-pricing",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/get-model-openapi-schema",
      "destination": "/api-reference/get-model-openapi-schema",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/search-catalog",
      "destination": "/api-reference/search-catalog",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/get-balance",
      "destination": "/api-reference/get-balance",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/get-usage-summary",
      "destination": "/api-reference/get-usage-summary",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/get-webhook-secret",
      "destination": "/api-reference/get-webhook-secret",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/rotate-webhook-secret",
      "destination": "/api-reference/rotate-webhook-secret",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/list-webhook-deliveries",
      "destination": "/api-reference/list-webhook-deliveries",
      "permanent": true
    },
    {
      "source": "/api-reference/platform/replay-webhook-delivery",
      "destination": "/api-reference/replay-webhook-delivery",
      "permanent": true
    }
  ]
}
