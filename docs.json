{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "ModelRunner Docs",
  "colors": {
    "primary": "#0f172a",
    "light": "#569dff",
    "dark": "#0f172a"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book",
        "description": "Set up your documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "api-keys",
              "guides/request-lifecycle",
              "faq"
            ]
          },
          {
            "group": "Wrappers",
            "pages": [
              "guides/wrappers/overview",
              "guides/wrappers/authoring",
              "guides/wrappers/prompt-templates",
              "guides/wrappers/switching-base-models"
            ]
          },
          {
            "group": "Platform features",
            "pages": [
              "guides/language-models",
              "guides/file-uploads",
              "guides/webhooks",
              "guides/data-retention",
              "guides/mcp-server"
            ]
          },
          {
            "group": "SDKs & recipes",
            "pages": [
              "clients/js-client",
              "clients/python-client",
              "recipes-nextjs-app"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "description": "Reference for the API",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/request-semantics",
              "api-reference/errors"
            ]
          },
          {
            "group": "Platform APIs",
            "openapi": {
              "source": "platform-openapi.json",
              "directory": "api-reference/platform"
            }
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@modelrunner.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "ModelRunner",
      "href": "https://modelrunner.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/modelrunnerai",
      "github": "https://github.com/modelrunner"
    }
  },
  "playground": {
    "display": "interactive",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "all"
    }
  },
  "integrations": {
